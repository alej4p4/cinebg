{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "scripts/arch-contract.mjs",
    "tests/**/*.ts",
    "tests/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignore": [
    "android/**",
    "dist/**",
    "graphify-out/**",
    "scripts/create-issues.py"
  ],
  "ignoreDependencies": [
    "@capacitor/android",
    "autoprefixer",
    "postcss",
    "tailwindcss"
  ]
}
