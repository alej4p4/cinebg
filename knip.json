{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "tests/**/*.ts",
    "tests/**/*.mjs"
  ],
  "project": [
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    "@capacitor/haptics",
    "@capacitor/keyboard",
    "@stryker-mutator/command-runner",
    "@stryker-mutator/html-reporter",
    "@stryker-mutator/typescript-checker"
  ],
  "rules": {
    "exports": "off",
    "types": "off",
    "duplicates": "off"
  }
}
