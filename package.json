    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.0",
    "@noriginmedia/norigin-spatial-navigation": "^3.3.0",
    "axios": "^1.7.0",
    "framer-motion": "^11.3.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.400.0",
    "qrcode": "^1.5.4",
